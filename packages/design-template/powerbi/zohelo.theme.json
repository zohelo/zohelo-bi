{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "zohelo",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#848D9A",
    "#104281",
    "#86B6EF",
    "#4B5563"
  ],
  "foreground": "#111827",
  "foregroundNeutralSecondary": "#4B5563",
  "foregroundNeutralTertiary": "#6B7280",
  "background": "#FFFFFF",
  "backgroundLight": "#F9FAFB",
  "backgroundNeutral": "#E3E6EA",
  "tableAccent": "#1E4E8C",
  "good": "#1B5E3F",
  "neutral": "#848D9A",
  "bad": "#A3261F",
  "minimum": "#D0484A",
  "center": "#F0EFEC",
  "maximum": "#2A78D6",
  "null": "#9CA3AF",
  "hyperlink": "#1E4E8C",
  "visitedHyperlink": "#163A69",
  "textClasses": {
    "callout": {
      "fontSize": 22.5,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#111827"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#111827"
    },
    "header": {
      "fontSize": 10.5,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#111827"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#374151"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E6EA"
              }
            },
            "width": 1,
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontSize": 12,
            "alignment": "left",
            "titleWrap": true
