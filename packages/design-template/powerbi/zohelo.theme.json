        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "labelColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#374151"
              }
