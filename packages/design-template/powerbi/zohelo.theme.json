        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#4B5563"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "divider": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
