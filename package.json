{
  "name": "zohelo-bi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/portal dev",
    "build": "bun run --cwd apps/portal build",
    "check": "tsc -p packages/semantic && tsc -p packages/visuals && tsc -p apps/portal && tsc -p apps/portal/functions"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "@zohelo/semantic": "workspace:*"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
